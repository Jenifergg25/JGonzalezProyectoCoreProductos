@if (Model.Usuarios != null)
{
    <div id="tablaUsuarios" @*class="table-responsive"*@>
        <div class="row">
            <div class="row mb-3 align-items-center">
                <div class="col-6 text-start">
                    <h2 class="m-0">Información Usuarios</h2>
                </div>
                <div class="col-6 text-end">
                    <a class="btn btn-success" href="@Url.Action("Form", "Usuario")">
                        <i class="bi bi-plus-circle"></i> Nuevo Usuario
                    </a>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered table-hover small text-nowrap">
                <thead class="table-dark text-center">
                    <tr>
                        <th scope="col">Acciones</th>
                        <th>Status</th>
                        <th>IdUsuario</th>
                        <th>Imagen</th>
                        <th>Username</th>
                        <th>Nombre</th>
                        <th>Apellido Paterno</th>
                        <th>Apellido Materno</th>
                        <th>Email</th>
                        <th>Contraseña</th>
                        <th>Sexo</th>
                        <th>Fecha de nacimiento</th>
                        <th>Teléfono</th>
                        <th>Celular</th>
                        <th>CURP</th>
                        <th>Rol</th>
                        <th>Calle</th>
                        <th># Interior</th>
                        <th># Exterior</th>
                        <th>Colonia</th>
                        <th>Codigo Postal</th>
                        <th>Municipio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (ML.Usuario usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a class="btn btn-warning btn-sm d-flex align-items-center"
                                       href="@Url.Action("Form", "Usuario", new { IdUsuario = usuario.IdUsuario })" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a class="btn btn-danger btn-sm d-flex align-items-center"
                                       href="@Url.Action("Delete", "Usuario", new { IdUsuario = usuario.IdUsuario })" onclick="return confirmarEliminacion(event, this);"
                                       title="Eliminar">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox"
                                           class="form-check-input form-switch"
                                           data-id="@usuario.IdUsuario"
                                           id="checkNativeSwitch_@usuario.IdUsuario"
                                           onchange="UpdateStatus(this)"
                                    @(usuario.Status ? "checked" : "") />
                                </div>
                            </td>
                            <td>@usuario.IdUsuario</td>
                            <td>
                                @if (usuario.Imagen != null)
                                {
                                    <img src="data:image/*;base64,@Convert.ToBase64String(@usuario.Imagen)" style="width:50px" />
                                }
                                else
                                {
                                    <img alt="Vista previa" id="previewImg" style="width:50px" src="~/Imagenes/usuarioDefault.png" />
                                }
                            </td>
                            <td>@usuario.UserName</td>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.ApellidoPaterno</td>
                            <td>@usuario.ApellidoMaterno</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Password</td>
                            <td>@usuario.Sexo</td>
                            <td>@usuario.FechaNacimiento</td>
                            <td>@usuario.Telefono</td>
                            <td>@usuario.Celular</td>
                            <td>@usuario.CURP</td>
                            <td>@usuario.Rol.Nombre</td>
                            <td>@usuario.Direccion.Calle</td>
                            <td>@usuario.Direccion.NumeroInterior</td>
                            <td>@usuario.Direccion.NumeroExterior</td>
                            <td>@usuario.Direccion.Colonia.Nombre</td>
                            <td>@usuario.Direccion.Colonia.CodigoPostal</td>
                            <td>@usuario.Direccion.Colonia.Municipio.Nombre</td>
                            <td>@usuario.Direccion.Colonia.Municipio.Estado.Nombre</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <p>No se encontro ningun usuario</p>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function confirmarEliminacion(event, link) {
        event.preventDefault();

        Swal.fire({
            title: '¿Estás seguro?',
            text: "El usuario se borrara de manera permanente",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Eliminar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = link.href;
            }
        });

        return false;
    }

    window.onload = function () {
        var mensaje = '@TempData["Mensaje"]';

        /* console.log("Mensaje recibido:", mensaje); */

        if (mensaje && mensaje.trim() !== "") {
            Swal.fire({
                title: 'Aviso',
                text: mensaje,
                icon: 'info',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
        }
    };
</script>

<script>
    function UpdateStatus(switchElement) {
        var checkbox = $(switchElement);
        var IdUsuario = checkbox.data('id');
        var Status = checkbox.is(':checked');

        $.ajax({
            url: '@Url.Action("UpdateStatus", "Usuario")',
            type: 'POST',
            data: { IdUsuario: IdUsuario, Status: Status },
            success: function (response) {
                if (!response.success) {
                    alert("Error al cambiar el status");
                    checkbox.prop('checked', !Status);
                }
            },
            error: function () {
                alert("Ocurrió un error");
                checkbox.prop('checked', !Status);
            }
        });
    }
</script>

<script>
    function MostrarOcultarTablaForm(btn) {
        var $formUsuario = $('#formUsuario');
        var $formCargaMasiva = $('#formCargaMasiva');

        var instanciaUsuario = bootstrap.Collapse.getOrCreateInstance($formUsuario[0]);
        var instanciaCarga = bootstrap.Collapse.getOrCreateInstance($formCargaMasiva[0]);

        instanciaCarga.hide();

        if ($formUsuario.hasClass('show')) {
            instanciaUsuario.hide();
        } else {
            instanciaUsuario.show();
        }
    }

    function MostrarOcultarCargaMasiva(btn) {
        var $formUsuario = $('#formUsuario');
        var $formCargaMasiva = $('#formCargaMasiva');

        var instanciaUsuario = bootstrap.Collapse.getOrCreateInstance($formUsuario[0]);
        var instanciaCarga = bootstrap.Collapse.getOrCreateInstance($formCargaMasiva[0]);

        instanciaUsuario.hide();

        if ($formCargaMasiva.hasClass('show')) {
            instanciaCarga.hide();
        } else {
            instanciaCarga.show();
        }
    }

    $(document).ready(function () {
        var $formUsuario = $('#formUsuario');
        var $formCargaMasiva = $('#formCargaMasiva');

        var instanciaUsuario = bootstrap.Collapse.getOrCreateInstance($formUsuario[0], { toggle: false });
        var instanciaCarga = bootstrap.Collapse.getOrCreateInstance($formCargaMasiva[0], { toggle: false });

        var mostrarCargaMasiva = '@(ViewBag.MostrarCargaMasiva ?? false)'.toLowerCase() === 'true';

        if (mostrarCargaMasiva) {
            instanciaCarga.show();
        } else {
            instanciaCarga.hide();
        }

        instanciaUsuario.hide();
    });


</script>
<script>
    var tipoArchivo = '';

    $(document).ready(function () {
        var seleccionado = $('input[name="tipoArchivo"]:checked').val();
        if (seleccionado) {
            cambiarTipoArchivo(seleccionado);
        }

        $('input[name="tipoArchivo"]').change(function () {
            cambiarTipoArchivo($(this).val());
        });
    });

    function cambiarTipoArchivo(tipo) {
        tipoArchivo = tipo;

        let tipoAceptado = tipo === 'txt' ? '.txt' : '.xls,.xlsx';
        $('#inputArchivo').val('');
        $('#inputArchivo').attr('accept', tipoAceptado);
        $('#btnValidar').prop('disabled', true);
    }

    function validarArchivo(event) {
        var input = event.target;
        var file = input.files[0];

        if (!file) {
            $('#btnValidar').prop('disabled', true);
            return;
        }

        if (!validarTipo(file.name)) {
            //alert("Tipo de archivo no permitido, selecciona un archivo " + (tipoArchivo === 'txt' ? ".txt" : ".xls o .xlsx"));
            Swal.fire({
                title: 'Tipo de archivo no permitido.',
                text: "Selecciona un archivo " + (tipoArchivo === 'txt' ? ".txt" : ".xls o .xlsx"),
                icon: 'error',
                confirmButtonColor: '#d33',
                confirmButtonText: 'OK'
            });
            input.value = "";
            $('#btnValidar').prop('disabled', true);
        } else {
            $('#btnValidar').prop('disabled', false);
        }
    }

    function validarTipo(fileName) {
        if (!fileName) return false;

        let extension = fileName.split('.').pop().toLowerCase();

        if (tipoArchivo === 'txt' && extension !== 'txt') {
            return false;
        }

        if (tipoArchivo === 'excel' && !['xls', 'xlsx'].includes(extension)) {
            return false;
        }

        return true;
    }
</script>