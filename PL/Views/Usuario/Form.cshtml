<script>

    //Validaciones con regex
    function ValidarSoloLetras(event) {
        var $input = $(event.target);
        var valor = $input.val();
        var letras = /^[a-zA-ZÁÉÍÓÚáéíóúÑñ\s]*$/;
        const $errorSpan = $input.parent().parent().find('p');

        if (event.type === "keypress") {
            var tecla = event.key;
            var regexLetra = /^[a-zA-ZÁÉÍÓÚáéíóúÑñ\s]$/;
            if (!regexLetra.test(tecla)) {
                $errorSpan.text("Solo se permiten letras").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
                return false;
            }

            if (valor.length >= 50) {
                $errorSpan.text("Máximo 50 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
                return false;
            }
        }

        if (event.type === "input" || event.type === "blur") {
            if (valor.length > 50) {
                $input.val(valor.substring(0, 50));
                $errorSpan.text("Máximo 50 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (valor.length < 2) {
                $errorSpan.text("Mínimo 2 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (letras.test(valor)) {
                $errorSpan.text('').addClass('text-danger').attr('hidden', 'hidden');
                $input.removeClass('is-invalid').addClass('is-valid');
                return;
            }
            $errorSpan.text('').attr('hidden', 'hidden');
            $input.removeClass('is-invalid').addClass('is-valid');
        }
    }



