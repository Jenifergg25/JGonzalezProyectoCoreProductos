<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    var CargarImagen = function (event) {
        var input = event.target;
        var file = input.files[0];

        if (!validar(file?.name)) {
            input.value = "";
            //$('#previewImg').attr('src', '');
            return;
        }

        var reader = new FileReader();
        reader.onload = function () {
            var output = $('#previewImg')[0];
            output.src = reader.result;
        }
        reader.readAsDataURL(file);
    }

    function validar(imgName) {
        let extensions = ["png", "jpg", "jpeg"];
        if (!imgName) {
            //alert("No se subió archivo");
            Swal.fire({
                title: 'Aviso',
                text: 'No se subió archivo.',
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
            return false;
        }
        let imgExtension = imgName.split('.').pop().toLowerCase();
        if (!extensions.includes(imgExtension)) {
            //alert("No es un archivo de imagen válido (png, jpg, jpeg)");
            Swal.fire({
                title: 'Archivo invalido',
                text: 'No es un formato de imagen válido (png, jpg, jpeg).',
                icon: 'error',
                confirmButtonColor: '#d33',
                confirmButtonText: 'OK'
            });
            return false;
        }
        return true;
    }

</script>
<script>
    function FillMunicipios() {
        var IdEstado = $('#ddlEstado').val();
        console.log(IdEstado)
        $.ajax({
            url: '@Url.Action("GetMunicipioByEstado")',
            dataType: 'JSON',
            method: 'GET',
            data: { IdEstado },
            success: function (resultMunicipios) {
                console.log(resultMunicipios)
                if (resultMunicipios.correct) {
                    $("#ddlMunicipio").empty()
                    $("#ddlColonia").empty()
                    $("#ddlMunicipio").append('<option value="">Seleccione un municipio</option>')
                    $("#ddlColonia").append('<option value="">Seleccione una colonia</option>')

                    $.each(resultMunicipios.objects, function (i, municipio) {
                        $("#ddlMunicipio").append('<option value = "' + municipio.idMunicipio + '">' + municipio.nombre + '</option>')
                    })
                }
            },
            error: function (ex) {
                alert(ex)
            }
        })
    }
</script>
<script>
    function FillColonias() {
        var IdMunicipio = $('#ddlMunicipio').val();
        $.ajax({
            url: '@Url.Action("GetColoniasByMunicipio")',
            dataType: 'JSON',
            method: 'GET',
            data: { IdMunicipio },
            success: function (resultColonias) {
                if (resultColonias.correct) {

                    $("#ddlColonia").empty()
                    $("#ddlColonia").append('<option value="">Seleccione una colonia</option>')

                    $.each(resultColonias.objects, function (i, colonia) {
                        $("#ddlColonia").append('<option value="' + colonia.idColonia + '">' + colonia.nombre + ' (' + colonia.codigoPostal + ')</option>');
                    });
                }
            }
        });
    }
</script>

