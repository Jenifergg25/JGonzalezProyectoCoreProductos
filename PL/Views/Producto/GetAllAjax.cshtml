
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<div class="row px-4">
    <div class="col-md-6">
        <h2>Catálogo de Productos</h2>

    </div>

    <div class="col-md-6 text-end">
    <button id="btnAgregarProducto" class="btn btn-success mb-4">
        <i class="bi bi-plus-lg"></i> Agregar Producto
    </button>
    </div>
</div>


<div class="container">

<div class="card shadow p-4 rounded bg-light my-3">
    <div class="row">
        <div class="col-md-6">
            <label for="ddlCategoria">Categoría</label>
                <select id="ddlCategoria" class="form-select" onchange="cargarSubCategorias(this.value, '#ddlSubcategoria')">
                <option value="">Seleccione una categoría</option>
            </select>
        </div>

        <div class="col-md-6">
            <label for="ddlSubcategoria">Subcategoría</label>
                <select id="ddlSubcategoria" class="form-select" disabled>
                <option value="">Seleccione una subcategoría</option>
            </select>
        </div>

        </div>
    </div>


<div id="contenedorProductos" class="row">
    </div>
</div>

<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header justify-content-center border-0">
                <h3 class="modal-title text-center w-100">Nuevo Producto</h3>
            </div>

            <div class="modal-body">
                <form id="formProducto" enctype="multipart/form-data" onsubmit="return validarCamposObligatorios();">
                    <input type="hidden" name="IdProducto" id="IdProducto" value="0" />
                    <div class="row mb-3">
                        <div class="d-flex justify-content-center">
                            <img id="previewImg" src="/Imagenes/iconoproducto.png" style="width: 200px; display:none;" />
                        </div>
                        <div class="d-flex justify-content-center mt-2">
                            <input type="file" class="form-control rounded w-50" name="Imagen" id="imagenProducto" accept="image/*" onchange="CargarImagen(this)" />
                        </div>
                    </div>

                    <div class="row m-2">
                        <div class="col">
                            <label for="nombreProducto" class="form-label">Nombre</label>
                            <div class="d-flex input-group">
                                <div class="input-group-text bg-dark text-white">
                                    <i class="bi bi-box p-1 fs-5"></i>
                                </div>
                                <input type="text" class="form-control" id="nombreProducto" name="Nombre" placeholder="Ingrese el nombre del producto" data-obligatorio="true" onkeypress="return ValidarNombreProducto(event);" oninput="ValidarNombreProducto(event);" onblur="ValidarNombreProducto(event)" />
                            </div>
                                <p hidden="hidden"></p>
                        </div>

                        <div class="col">
                            <label for="precioProducto" class="form-label">Precio</label>
                            <div class="d-flex input-group"> 
                                <div class="input-group-text bg-dark text-white">
                                    <i class="bi bi-currency-dollar p-1 fs-5"></i>
                                </div>
                                <input type="number" step="0.01" class="form-control" id="precioProducto" name="Precio" placeholder="Ingrese el precio del producto" data-obligatorio="true" onkeypress="return ValidarPrecio(event);" oninput="ValidarPrecio(event);" onblur="ValidarPrecio(event)" />
                            </div>
                                <p hidden="hidden"></p>
                        </div>
                    </div>

                    <div class="row m-2">
                        <div class="col">
                            <label for="descripcionProducto" class="form-label">Descripción</label>
                            <div class="d-flex input-group mb-3">
                                <div class="input-group-text bg-dark text-white">
                                    <i class="bi bi-card-text p-1 fs-5"></i>
                                </div>
                                <textarea class="form-control" id="descripcionProducto" name="Descripcion" placeholder="Ingrese la descripción del producto" rows="3" onkeypress="return validarDescripcion(event);" oninput="validarDescripcion(event);"></textarea>
                            </div>
                                <p hidden="hidden"></p>
                        </div>
                    </div>

                    <h5 class="text-center m-4">CATEGORÍA Y SUBCATEGORÍA</h5>

                    <div class="row m-2">
                        <div class="col">
                            <label for="ddlCategoriaModal" class="form-label">Categoría</label>
                            <div class="d-flex input-group">
                                <div class="input-group-text bg-dark text-white">
                                    <i class="bi bi-collection p-1 fs-5"></i>
                                </div>
                                <select class="form-select" id="ddlCategoriaModal" name="SubCategoria.Categoria.IdCategoria" data-obligatorio="true" onchange="cargarSubCategorias(this.value, '#ddlSubCategoriaModal'),  validarDropDownList(this);">
                                    <option value="">Selecciona una categoría</option>
                                </select>
                            </div>
                                <p hidden="hidden"></p>
                        </div>

                        <div class="col">
                            <label for="ddlSubCategoriaModal" class="form-label">Subcategoría</label>
                            <div class="d-flex input-group">
                                <div class="input-group-text bg-dark text-white">
                                    <i class="bi bi-tag p-1 fs-5"></i>
                                </div>
                                <select class="form-select" id="ddlSubCategoriaModal" name="SubCategoria.IdSubCategoria" data-obligatorio="true" disabled onchange="validarDropDownList(this);">
                                    <option value="">Selecciona una subcategoría</option>
                                </select>
                            </div>
                                <p hidden="hidden"></p>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer justify-content-center border-0">
                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formProducto" class="btn btn-dark">
                    <i class="bi bi-save me-2"></i> Guardar
                </button>
            </div>

        </div>
    </div>
</div>



<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        cargarCategorias('#ddlCategoria');
        mostrarMensajeInicial();

        $('#ddlCategoria').change(function () {
            let categoriaId = $(this).val();
            if (categoriaId) {
                cargarSubCategorias(categoriaId, '#ddlSubcategoria');
                $('#ddlSubcategoria').prop('disabled', false);
            } else {
                resetearDropdown('#ddlSubcategoria');
            }
            cargarProductos();
        });

        $('#ddlSubcategoria').change(cargarProductos);

        $('#btnAgregarProducto').click(abrirModalNuevoProducto);

        $('#ddlCategoriaModal').change(function () {
            const idCategoria = $(this).val();
            if (idCategoria) {
                $('#ddlSubCategoriaModal').prop('disabled', false);
                cargarSubCategorias(idCategoria, '#ddlSubCategoriaModal');
            } else {
                resetearDropdown('#ddlSubCategoriaModal');
            }
        });


        function validarCamposObligatorios() {
            let esValido = true;

            $('[data-obligatorio="true"]').each(function () {
                const $input = $(this);
                const valor = $input.val().trim();
                const $errorSpan = $input.parent().parent().find('p');

                if (valor === '') {
                    $errorSpan.text('Este campo es obligatorio').addClass('text-danger').removeAttr('hidden');
                    $input.removeClass('is-valid').addClass('is-invalid');
                    esValido = false;
                }
                else {
                    $errorSpan.text('').addClass('text-danger').attr('hidden', 'hidden');
                    $input.removeClass('is-invalid').addClass('is-valid');
                }
                
            });

            return esValido;
        }




        $('#formProducto').submit(function (e) {
            e.preventDefault();

            if(!validarCamposObligatorios()){
                return;
            }

            let formData = new FormData(this);

            $.ajax({
                url: '/Producto/AddOrUpdate',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Aviso', response.message, 'success');
                        $('#modalProducto').modal('hide');
                        cargarProductos();
                        limpiarFormulario();
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Error inesperado al guardar el producto.', 'error');
                }
            });
        });
    });

    function limpiarFormulario() {
        $('#formProducto')[0].reset();
        $('#IdProducto').val('');
        $('#previewImg').attr('src', '/Imagenes/iconoproducto.png').show();
        $('#formProducto').find('p').text('').addClass('text-danger').attr('hidden', 'hidden');
        $('#formProducto').find('input, select, textarea').removeClass('is-invalid is-valid');
        resetearDropdown('#ddlSubCategoriaModal');
    }

    function CargarImagen(input) {
        var file = input.files[0];

        if (validar(file?.name)) {
            if (input.files && file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewImg').attr('src', e.target.result).show();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
        else{
            input.value = "";
            $('#previewImg').attr('src', '/Imagenes/iconoproducto.png').show();
            return;
        }
    }


    function validar(imgName) {
        let extensions = ["png", "jpg", "jpeg"];
        if (!imgName) {
            Swal.fire({
                title: 'Aviso',
                text: 'No se subió archivo.',
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
            return false;
        }
        let imgExtension = imgName.split('.').pop().toLowerCase();
        if (!extensions.includes(imgExtension)) {
            Swal.fire({
                title: 'Archivo invalido',
                text: 'No es un formato de imagen válido (png, jpg, jpeg).',
                icon: 'error',
                confirmButtonColor: '#d33',
                confirmButtonText: 'OK'
            });
            return false;
        }
        return true;
    }

    function abrirModalNuevoProducto() {
        cargarCategorias('#ddlCategoriaModal').done(function () {
            $('#modalProducto .modal-title').text('Nuevo Producto');
            $('#imagenProducto').val('');
            resetearDropdown('#ddlSubCategoriaModal');
            limpiarFormulario();

            new bootstrap.Modal(document.getElementById('modalProducto')).show();
        });
    }

    function resetearDropdown(selector) {
        $(selector)
            .empty()
            .append('<option value="">Seleccione una subcategoría</option>')
            .prop('disabled', true);
    }


    function mostrarMensajeInicial() {
        const contenedor = $("#contenedorProductos");
        contenedor.empty();
        contenedor.append(`
            <div class="col-12 d-flex justify-content-center">
                <div class="alert alert-secondary text-center w-100 shadow">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Por favor, selecciona una categoría y una subcategoría para ver los productos disponibles.
                </div>
            </div>
        `);
    }

    function cargarCategorias(selectorCategoria) {
        return $.ajax({
            url: '/Producto/GetCategorias',
            method: 'GET',
            success: function (data) {
                var ddl = $(selectorCategoria);
                ddl.empty();
                ddl.append('<option value="">Seleccione una categoría</option>');
                $.each(data, function (i, categoria) {
                    ddl.append('<option value="' + categoria.idCategoria + '">' + categoria.nombre + '</option>');
                });
            }
        });
    }

    function cargarSubCategorias(categoriaId, selectorSubcategoria) {
        return $.ajax({
            url: '/Producto/GetSubcategorias',
            method: 'GET',
            data: { idCategoria: categoriaId },
            success: function (data) {
                var ddl = $(selectorSubcategoria);
                ddl.empty();
                ddl.append('<option value="">Seleccione una subcategoría</option>');
                $.each(data, function (i, subcategoria) {
                    ddl.append('<option value="' + subcategoria.idSubCategoria + '">' + subcategoria.nombre + '</option>');
                });
            }
        });
    }

    function cargarProductos() {
        var Idcategoria = $('#ddlCategoria').val();
        var IdsubCategoria = $('#ddlSubcategoria').val();

        $.ajax({
            url: '/Producto/GetAllJson',
            method: 'GET',
            data: {
                Idcategoria: Idcategoria,
                IdsubCategoria: IdsubCategoria
            },
            success: function (data) {
                var contenedor = $('#contenedorProductos');
                contenedor.empty();

                if (!data.length) {
                    contenedor.append(`
                        <div class="col-12 d-flex justify-content-center">
                            <div class="alert alert-secondary text-center w-100 shadow">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Seleccione una subcategoria para mostrar los productos.
                            </div>
                        </div>
                    `);
                    return; 
                }

                $.each(data, function (i, producto) {
                    var imgSrc = producto.imagenBase64 ? producto.imagenBase64 : '/Imagenes/iconoproducto.png';
                    contenedor.append(`
                        <div class="col-lg-4 col-md-5 d-flex justify-content-center mb-4">
                            <div class="card shadow-lg border-0 rounded-4" style="width: 100%; max-width: 400px;">
                                <img src="${imgSrc}" class="card-img-top rounded-top-4" alt="${producto.nombre}"
                                    style="height: 200px; object-fit: cover;"
                                    onerror="this.onerror=null;this.src='/images/icon-placeholder.png';" />
                                <div class="card-body d-flex flex-column text-center">
                                        <h5 class="card-title mb-2 text-dark  fw-bold">${producto.nombre}</h5>
                                        <p class="card-text">${producto.categoria || 'N/A'}</p>
                                    <p class="card-text small text-muted text-wrap" title="${producto.descripcion || ''}">
                                        ${producto.descripcion || 'Sin descripción'}
                                    </p>
                                    <p class="card-text"><strong>Subcategoría:</strong> ${producto.subCategoria || 'N/A'}</p>
                                    <p class="card-text fs-5 fw-semibold text-success mb-3">
                                        $${producto.precio.toFixed(2)} el kilo
                                    </p>
                                    <div class="d-flex justify-content-center gap-2 mt-auto">
                                            <button class="btn btn-warning btn-sm px-3" onclick="obtenerProductoPorId(${producto.idProducto})">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>
                                            <button class="btn btn-danger btn-sm px-3" onclick="eliminarProducto(${producto.idProducto})">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `);

                });

            }
        });
    }




    function obtenerProductoPorId(idProducto) {
        $('#modalProducto .modal-title').text('Modificar Producto');
        $.ajax({
            url: '/Producto/GetById',
            method: 'GET',
            data: { idProducto: idProducto },
            success: function (producto) {
                if (producto) {
                    $('#IdProducto').val(producto.idProducto);
                    $('#nombreProducto').val(producto.nombre);
                    $('#precioProducto').val(producto.precio);
                    $('#descripcionProducto').val(producto.descripcion);

                    cargarCategorias('#ddlCategoriaModal').done(function () {
                        $('#ddlCategoriaModal').val(producto.subCategoria.categoria.idCategoria);
                        cargarSubCategorias(producto.subCategoria.categoria.idCategoria, '#ddlSubCategoriaModal').done(function () {
                            $('#ddlSubCategoriaModal').val(producto.subCategoria.idSubCategoria);
                            $('#ddlSubCategoriaModal').prop('disabled', false);
                        });
                    });

                    if (producto.imagenBase64) {
                        $('#previewImg').attr('src', producto.imagenBase64).show();
                    } else {
                        $('#previewImg').attr('src', '/Imagenes/iconoproducto.png');
                    }

                    var modal = new bootstrap.Modal(document.getElementById('modalProducto'));
                    modal.show();
                } else {
                    alert('Producto no encontrado.');
                }
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener producto:', error);
                alert('Ocurrió un error al obtener el producto.');
            }
        });
    }




    function eliminarProducto(idProducto) {
        Swal.fire({
            title: 'Advertencia',
            text: "¿Deseas eliminar este producto?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Aceptar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: "/Producto/DeleteJson",
                    data: { idProducto: idProducto },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Aviso', 'El producto fue eliminado', 'success');
                            cargarProductos(); 
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'No se pudo eliminar el producto.', 'error');
                    }
                });
            }
        });
    }


    function ValidarNombreProducto(event) {
        var $input = $(event.target);
        var valor = $input.val();
        var letras = /^[a-zA-ZÁÉÍÓÚáéíóúÑñ\s]*$/;
        const $errorSpan = $input.parent().parent().find('p');

        if (event.type === "keypress") {
            var tecla = event.key;
            var regexLetra = /^[a-zA-ZÁÉÍÓÚáéíóúÑñ\s]$/;
            if (!regexLetra.test(tecla)) {
                $errorSpan.text("El nombre del producto solo puede tener letras").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
                return false;
            }

            if (valor.length >= 100) {
                $errorSpan.text("El nombre debe tener máximo 100 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
                return false;
            }
        }

        if (event.type === "input" || event.type === "blur") {
            if (valor.length > 100) {
                $input.val(valor.substring(0, 100));
                $errorSpan.text("El nombre debe tener máximo 100 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (valor.length < 4) {
                $errorSpan.text("El nombre debe tener mínimo 4 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (letras.test(valor)) {
                $errorSpan.text('').addClass('text-danger').attr('hidden', 'hidden');
                $input.removeClass('is-invalid').addClass('is-valid');
                return;
            }
            $errorSpan.text('').attr('hidden', 'hidden');
            $input.removeClass('is-invalid').addClass('is-valid');
        }
    }

    function ValidarPrecio(event) {
        var $input = $(event.target);
        var valor = $input.val();
        const $errorSpan = $input.parent().parent().find('p');

        var regexDecimal = /^\d+(\.\d{1,2})?$/;

        if (event.type === 'keypress') {
            const tecla = event.key;
            const valorActual = $input.val();

            if (!/[\d.]/.test(tecla)) {
                $errorSpan.text("Solo numeros y decimales ej. 12.50, 8, 25.50").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
            }

            if (tecla === '.' && valorActual.includes('.')) {
                event.preventDefault();
            }
        }

        if (event.type === "input" || event.type === "blur") {
            if (valor.trim() === "") {
                $errorSpan.text("El campo precio es obligatorio").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (regexDecimal.test(valor)) {
                $errorSpan.text('').attr('hidden', 'hidden');
                $input.removeClass('is-invalid').addClass('is-valid');
            } else {
                $errorSpan.text("Ingrese un número válido (ej: 10 o 10.50)").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
            }
        }
    }

    function validarDescripcion(event) {
        var $input = $(event.target);
        var valor = $input.val();
        const $errorSpan = $input.parent().parent().find('p');
        var regexCalle = /^[a-zA-Z0-9ÁÉÍÓÚáéíóúÑñ\s.,-]{10,500}$/;

        if (event.type === "keypress") {
            var tecla = event.key;

            if ($input.val().length >= 500) {
                event.preventDefault();
                $errorSpan.text("La descripcion debe tener máximo 500 caracteres permitidos").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return false;
            }
        }

        if (event.type === "input" || event.type === "blur") {
            if (!regexCalle.test(valor)) {
                $errorSpan.text("La descripción debe tener entre 10 y 500 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
            }
            else if (valor.length < 10) {
                $errorSpan.text("La descripcion debe tener mínimo 10 caracteres requeridos").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
            }
            else {
                $errorSpan.text("").addClass('text-danger').attr('hidden', 'hidden');
                $input.removeClass('is-invalid').addClass('is-valid');
            }
        }
    }
    function validarDropDownList(element) {
        const $select = $(element);
        const valor = $select.val();
        var $errorSpan = $select.closest('.input-group').next('p');
        if (valor && valor !== "") {
            $select.removeClass('is-invalid').addClass('is-valid');
            $errorSpan.text("").attr('hidden', 'hidden');
        } else {
            $select.removeClass('is-valid');
        }
    }
</script>