@model ML.Producto

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<h2>Catálogo de Productos</h2>

<div class="container">

<div class="card shadow p-4 rounded bg-light my-3">
    <div class="row">
        <div class="col-md-6">
            <label for="ddlCategoria">Categoría</label>
            <select id="ddlCategoria" class="form-control">
                <option value="">Seleccione una categoría</option>
            </select>
        </div>

        <div class="col-md-6">
            <label for="ddlSubcategoria">Subcategoría</label>
            <select id="ddlSubcategoria" class="form-control" disabled>
                <option value="">Seleccione una subcategoría</option>
            </select>
        </div>
    </div>
</div>


<div id="contenedorProductos" class="row">
    </div>
</div>




<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        cargarCategorias();
        mostrarMensajeInicial();

        $('#ddlCategoria').change(function () {
            var categoriaId = $(this).val();

            if (categoriaId) {
                cargarSubCategorias(categoriaId);
                $('#ddlSubcategoria').prop('disabled', false);
            } else {
                $('#ddlSubcategoria').empty().append('<option value="">Seleccione una subcategoría</option>').prop('disabled', true);
            }

            cargarProductos();
        });

        $('#ddlSubcategoria').change(function () {
            cargarProductos();
        });
    });

    function mostrarMensajeInicial() {
        const contenedor = $("#contenedorProductos");
        contenedor.empty();
        contenedor.append(`
            <div class="col-12 d-flex justify-content-center">
                <div class="alert alert-secondary text-center w-100 shadow">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Por favor, selecciona una categoría y una subcategoría para ver los productos disponibles.
                </div>
            </div>
        `);
    }

    function cargarCategorias() {
        $.ajax({
            url: '/Producto/GetCategorias',
            method: 'GET',
            success: function (data) {
                var ddl = $('#ddlCategoria');
                ddl.empty();
                ddl.append('<option value="">Seleccione una categoría</option>');
                $.each(data, function (i, categoria) {
                    ddl.append('<option value="' + categoria.idCategoria + '">' + categoria.nombre + '</option>');
                });
            }
        });
    }

    function cargarSubCategorias(categoriaId) {
        $.ajax({
            url: '/Producto/GetSubcategorias',
            method: 'GET',
            data: { idCategoria: categoriaId },
            success: function (data) {
                var ddl = $('#ddlSubcategoria');
                ddl.empty();
                ddl.append('<option value="">Seleccione una subcategoría</option>');
                $.each(data, function (i, subcategoria) {
                    ddl.append('<option value="' + subcategoria.idSubCategoria + '">' + subcategoria.nombre + '</option>');
                });
            }
        });
    }

    function cargarProductos() {
        var Idcategoria = $('#ddlCategoria').val();
        var IdsubCategoria = $('#ddlSubcategoria').val();

        $.ajax({
            url: '/Producto/GetAllJson',
            method: 'GET',
            data: {
                Idcategoria: Idcategoria,
                IdsubCategoria: IdsubCategoria
            },
            success: function (data) {
                var contenedor = $('#contenedorProductos');
                contenedor.empty();

                if (!data.length) {
                    contenedor.append(`
                        <div class="col-12 d-flex justify-content-center">
                            <div class="alert alert-secondary text-center w-100 shadow">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Seleccione una subcategoria para mostrar los productos.
                            </div>
                        </div>
                    `);
                    return; 
                }

                $.each(data, function (i, producto) {
                    var imgSrc = producto.imagenBase64 ? producto.imagenBase64 : '/Imagenes/iconoproducto.png';
                    contenedor.append(`
                        <div class="col-lg-4 col-md-5 d-flex justify-content-center mb-4">
                            <div class="card shadow-lg border-0 rounded-4" style="width: 100%; max-width: 350px;">
                                <img src="${imgSrc}" class="card-img-top rounded-top-4" alt="${producto.nombre}"
                                    style="height: 200px; object-fit: cover;"
                                    onerror="this.onerror=null;this.src='/images/icon-placeholder.png';" />
                                <div class="card-body d-flex flex-column text-center">
                                        <h5 class="card-title mb-2 text-dark  fw-bold">${producto.nombre}</h5>
                                        <p class="card-text">${producto.categoria || 'N/A'}</p>
                                    <p class="card-text small text-muted text-wrap" title="${producto.descripcion || ''}">
                                        ${producto.descripcion || 'Sin descripción'}
                                    </p>
                                    <p class="card-text"><strong>Subcategoría:</strong> ${producto.subCategoria || 'N/A'}</p>
                                    <p class="card-text fs-5 fw-semibold text-success mb-3">
                                        $${producto.precio.toFixed(2)}
                                    </p>
                                    <div class="d-flex justify-content-center gap-2 mt-auto">
                                        <button class="btn btn-warning btn-sm px-3" onclick="editarProducto(${producto.idProducto})">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>
                                        <button class="btn btn-danger btn-sm px-3" onclick="eliminarProducto(${producto.idProducto})">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `);

                });

            }
        });
    }


</script>