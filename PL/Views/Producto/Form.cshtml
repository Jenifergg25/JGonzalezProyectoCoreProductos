@model ML.Producto
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.12.1/font/bootstrap-icons.min.css">
<div class="container-fluid d-flex justify-content-center align-items-center mt-5 mb-5 pt-4 pb-4">
<div class="col-12 col-sm-10 col-md-8 col-lg-8 border p-4 rounded-4 shadow-lg bg-white">
        <h3 class="text-center m-2">FORMULARIO</h3>

        @using (Html.BeginForm("Form", "Producto", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return validarCamposObligatorios();", @id = "formAgregarProducto" }))
        {
            <div class="row mb-3">
                @Html.HiddenFor(model => model.IdProducto)
            </div>

            <div class="row m-2">
                @Html.HiddenFor(model => model.Imagen)
                <div class="text-center">
                    @if (Model.Imagen != null && Model.Imagen.Length > 0)
                    {

                        var base64 = Convert.ToBase64String(Model.Imagen);
                        var imageScr = String.Format("data:image/*;base64,{0}", base64);
                        <img src="@imageScr" id="previewImg" style="width:250px">
                        <div class="d-flex justify-content-center">
                            <input type="file" class="form-control rounded" name="imgName" id="inputImgFile" onchange="CargarImagen(event)" />
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-2">
                            <i class="bi bi-box-seam" style="font-size: 5rem; color: gray;"></i>
                        </div>
                        <div class="d-flex justify-content-center">
                            <input type="file" class="form-control rounded" name="imgName" id="inputImgFile" onchange="CargarImagen(event)" />
                        </div>
                    }
                </div>
            </div>
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <h4 class="text-center m-5">DATOS DEL PRODUCTO</h4>
            <div class="row m-2">
                <div class="col">
                    @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-box p-1 fs-5"></i>
                        </div>
                        @Html.TextBoxFor(model => model.Nombre, new
                            {
                                @class = "form-control",
                                placeholder = "Ingrese el nombre del producto",
                                id = "txbNombre",
                                data_obligatorio = "true",
                                onkeypress = "return ValidarSoloLetras(event);",
                                oninput = "ValidarSoloLetras(event);",
                                onblur = "ValidarSoloLetras(event)"
                            })
                    </div>
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                    <p hidden="hidden"></p>
                </div>

                <div class="col">
                    @Html.LabelFor(model => model.Precio, new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-currency-dollar p-1 fs-5"></i>
                        </div>
                        @Html.TextBoxFor(model => model.Precio, new
                            {
                                @class = "form-control",
                                placeholder = "Ingrese el precio del producto",
                                id = "txbNombre",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                data_obligatorio = "true",
                                onkeypress = "return ValidarSoloLetras(event);",
                                oninput = "ValidarSoloLetras(event);",
                                onblur = "ValidarSoloLetras(event)"
                            })
                    </div>
                    @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
                    <p hidden="hidden"></p>
                </div>
            </div>

            <div class="row m-2">
                <div class="col">
                    @Html.LabelFor(model => model.Descripcion, new { @class = "form-label" })
                    <div class="d-flex input-group mb-3">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-card-text p-1 fs-5"></i>
                        </div>
                        @Html.TextAreaFor(model => model.Descripcion, new
                            {
                                @class = "form-control",
                                placeholder = "Ingrese la descripción del producto",
                                id = "txbDescripcion",
                                rows = "3"
                            })
                    </div>


                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                    <p hidden="hidden"></p>
                </div>
            </div>


            <h4 class="text-center m-5">CATEGORIA Y SUBCATEGORIA</h4>

            <div class="row m-2">
                <div class="col">
                    @Html.LabelFor(model => model.SubCategoria.Categoria.IdCategoria, "Categoria", new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-collection p-1 fs-5"></i>
                        </div>
                        @Html.DropDownListFor(model => model.SubCategoria.Categoria.IdCategoria, 
                            new SelectList(Model.SubCategoria.Categoria.Categorias, "IdCategoria", "Nombre", Model.SubCategoria.Categoria.IdCategoria), "Selecciona una categoria",
                                 new { @class = "form-select", data_obligatorio = "true", id = "ddlCategoria"/* , @onchange = "validarDropDownList(this);"  */})
                    </div>
                    <p hidden="hidden"></p>
                    @Html.ValidationMessageFor(model => model.SubCategoria.Categoria.IdCategoria, "", new { @class = "text-danger" })
                </div>

                <div class="col">
                    @Html.LabelFor(model => model.SubCategoria.IdSubCategoria, "SubCategoria", new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-tag p-1 fs-5"></i>
                        </div>
                        @Html.DropDownListFor(model => model.SubCategoria.IdSubCategoria,
                                 new SelectList(Model.SubCategoria.SubCategorias, "IdSubCategoria", "Nombre", Model.SubCategoria.IdSubCategoria), "Selecciona una subcategoria",
                                 new { @class = "form-select", data_obligatorio = "true", id = "ddlSubcategoria"/* , @onchange = "validarDropDownList(this);" */ })
                    </div>
                    <p hidden="hidden"></p>
                    @Html.ValidationMessageFor(model => model.SubCategoria.IdSubCategoria, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="text-center mt-3">
            <button type="submit" class="btn btn-dark w-25 mt-4">
                <i class="bi bi-save me-2"></i> Guardar producto
            </button>
            </div>
        }

    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>


<script>
$('#ddlCategoria').change(function () {
    var idCategoria = $(this).val();

    if (idCategoria !== "") {
        $.ajax({
            url: '/Producto/GetSubcategorias',
            type: 'GET',
            data: { idCategoria: idCategoria },
            success: function (data) {
                var ddlSubcategoria = $('#ddlSubcategoria');
                ddlSubcategoria.empty();
                ddlSubcategoria.append('<option value="">Selecciona una subcategoría</option>');
                $.each(data, function (i, subcategoria) {
                    ddlSubcategoria.append('<option value="' + subcategoria.idSubCategoria + '">' + subcategoria.nombre + '</option>');
                });
            }
        });
    }
});

</script>