@model ML.Producto
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.12.1/font/bootstrap-icons.min.css">
<div class="container-fluid d-flex justify-content-center align-items-center mt-5 mb-5 pt-4 pb-4">
<div class="col-12 col-sm-10 col-md-8 col-lg-8 border p-4 rounded-4 shadow-lg bg-white">
        <h3 class="text-center m-2">FORMULARIO</h3>

        @using (Html.BeginForm("Form", "Producto", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return validarCamposObligatorios();", @id = "formAgregarProducto" }))
        {
            <div class="row mb-3">
                @Html.HiddenFor(model => model.IdProducto)
            </div>

            <div class="row m-2">
                <div class="d-flex justify-content-center">
                    <img id="previewImg"
                         src="@(Model.Imagen != null && Model.Imagen.Length > 0 
                                    ? $"data:image/*;base64,{Convert.ToBase64String(Model.Imagen)}" 
                                    : "")"
                         style="width: 250px; display:@(Model.Imagen != null && Model.Imagen.Length > 0 ? "block" : "none");" />

                    @if (Model.Imagen == null || Model.Imagen.Length == 0)
                    {
                        <i class="bi bi-box-seam" id="iconoImagen" style="font-size: 5rem; color: gray;"></i>
                    }
                </div>
                @Html.HiddenFor(model => model.Imagen)
                <div class="d-flex justify-content-center">
                    <input type="file"
                           class="form-control rounded w-50"
                           name="imgName"
                           id="inputImgFile"
                           onchange="CargarImagen(event)" />
                </div>
            </div>
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <h4 class="text-center m-5">DATOS DEL PRODUCTO</h4>
            <div class="row m-2">
                <div class="col">
                    @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-box p-1 fs-5"></i>
                        </div>
                        @Html.TextBoxFor(model => model.Nombre, new
                            {
                                @class = "form-control",
                                placeholder = "Ingrese el nombre del producto",
                                id = "txbNombre",
                                data_obligatorio = "true",
                                onkeypress = "return ValidarNombreProducto(event);",
                                oninput = "ValidarNombreProducto(event);",
                                onblur = "ValidarNombreProducto(event)"
                            })
                    </div>
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                    <p hidden="hidden"></p>
                </div>

                <div class="col">
                    @Html.LabelFor(model => model.Precio, new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-currency-dollar p-1 fs-5"></i>
                        </div>
                        @Html.TextBoxFor(model => model.Precio, new
                            {
                                @class = "form-control",
                                placeholder = "Ingrese el precio del producto",
                                id = "txbPrecio",
                                type = "text",
                                data_obligatorio = "true",
                                onkeypress = "return ValidarPrecio(event);",
                                oninput = "ValidarPrecio(event);",
                                onblur = "ValidarPrecio(event)"
                            })
                    </div>
                    @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
                    <p hidden="hidden"></p>
                </div>
            </div>

            <div class="row m-2">
                <div class="col">
                    @Html.LabelFor(model => model.Descripcion, new { @class = "form-label" })
                    <div class="d-flex input-group mb-3">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-card-text p-1 fs-5"></i>
                        </div>
                        @Html.TextAreaFor(model => model.Descripcion, new
                            {
                                @class = "form-control",
                                placeholder = "Ingrese la descripción del producto",
                                id = "txbDescripcion",
                                rows = "3"
                            })
                    </div>


                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                    <p hidden="hidden"></p>
                </div>
            </div>


            <h4 class="text-center m-5">CATEGORIA Y SUBCATEGORIA</h4>

            <div class="row m-2">
                <div class="col">
                    @Html.LabelFor(model => model.SubCategoria.Categoria.IdCategoria, "Categoria", new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-collection p-1 fs-5"></i>
                        </div>
                        @Html.DropDownListFor(model => model.SubCategoria.Categoria.IdCategoria, 
                            new SelectList(Model.SubCategoria.Categoria.Categorias, "IdCategoria", "Nombre", Model.SubCategoria.Categoria.IdCategoria), "Selecciona una categoria",
                                 new { @class = "form-select", data_obligatorio = "true", id = "ddlCategoria", @onchange = "validarDropDownList(this);" })
                    </div>
                    <p hidden="hidden"></p>
                    @Html.ValidationMessageFor(model => model.SubCategoria.Categoria.IdCategoria, "", new { @class = "text-danger" })
                </div>

                <div class="col">
                    @Html.LabelFor(model => model.SubCategoria.IdSubCategoria, "SubCategoria", new { @class = "form-label" })
                    <div class="d-flex input-group">
                        <div class="input-group-text bg-dark text-white">
                            <i class="bi bi-tag p-1 fs-5"></i>
                        </div>
                        @Html.DropDownListFor(model => model.SubCategoria.IdSubCategoria,
                                 new SelectList(Model.SubCategoria.SubCategorias, "IdSubCategoria", "Nombre", Model.SubCategoria.IdSubCategoria), "Selecciona una subcategoria",
                                 new { @class = "form-select", data_obligatorio = "true", id = "ddlSubcategoria", @onchange = "validarDropDownList(this);" })
                    </div>
                    <p hidden="hidden"></p>
                    @Html.ValidationMessageFor(model => model.SubCategoria.IdSubCategoria, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="text-center mt-3">
            <button type="submit" class="btn btn-dark w-25 my-4">
                <i class="bi bi-save me-2"></i> Guardar producto
            </button>
            </div>
        }

    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
function CargarImagen(event) {
        var input = event.target;
        var preview = document.getElementById("previewImg");
        var icono = document.getElementById("iconoImagen");

        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
                if (icono) {
                    icono.style.display = "none";
                }
            };

            reader.readAsDataURL(input.files[0]);
        }
    }

    function validar(imgName) {
        let extensions = ["png", "jpg", "jpeg"];
        if (!imgName) {
            //alert("No se subió archivo");
            Swal.fire({
                title: 'Aviso',
                text: 'No se subió archivo.',
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
            return false;
        }
        let imgExtension = imgName.split('.').pop().toLowerCase();
        if (!extensions.includes(imgExtension)) {
            //alert("No es un archivo de imagen válido (png, jpg, jpeg)");
            Swal.fire({
                title: 'Archivo invalido',
                text: 'No es un formato de imagen válido (png, jpg, jpeg).',
                icon: 'error',
                confirmButtonColor: '#d33',
                confirmButtonText: 'OK'
            });
            return false;
        }
        return true;
    }

</script>

<script>
$('#ddlCategoria').change(function () {
    var idCategoria = $(this).val();

    if (idCategoria !== "") {
        $.ajax({
            url: '/Producto/GetSubcategorias',
            type: 'GET',
            data: { idCategoria: idCategoria },
            success: function (data) {
                var ddlSubcategoria = $('#ddlSubcategoria');
                ddlSubcategoria.empty();
                ddlSubcategoria.append('<option value="">Selecciona una subcategoría</option>');
                $.each(data, function (i, subcategoria) {
                    ddlSubcategoria.append('<option value="' + subcategoria.idSubCategoria + '">' + subcategoria.nombre + '</option>');
                });
            }
        });
    }
});



    function ValidarPrecio(event) {
        var $input = $(event.target);
        var valor = $input.val();
        var numeros = /^[0-9]$/;
        const $errorSpan = $input.parent().parent().find('p');

        if (event.type === "input" || event.type === "blur") {
            if (valor = 0) {
                $errorSpan.text("El precio no debe ir vacio").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }
            if (numeros.test(valor)) {
                $errorSpan.text('').addClass('text-danger').attr('hidden', 'hidden');
                $input.removeClass('is-invalid').addClass('is-valid');
                return;
            }
            $errorSpan.text('').attr('hidden', 'hidden');
            $input.removeClass('is-invalid').addClass('is-valid');
        }
    }



    //Validaciones con regex
    function ValidarNombreProducto(event) {
        var $input = $(event.target);
        var valor = $input.val();
        var letras = /^[a-zA-ZÁÉÍÓÚáéíóúÑñ\s]*$/;
        const $errorSpan = $input.parent().parent().find('p');

        if (event.type === "keypress") {
            var tecla = event.key;
            var regexLetra = /^[a-zA-ZÁÉÍÓÚáéíóúÑñ\s]$/;
            if (!regexLetra.test(tecla)) {
                $errorSpan.text("Solo se permiten letras").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
                return false;
            }

            if (valor.length >= 100) {
                $errorSpan.text("Máximo 100 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                event.preventDefault();
                return false;
            }
        }

        if (event.type === "input" || event.type === "blur") {
            if (valor.length > 100) {
                $input.val(valor.substring(0, 100));
                $errorSpan.text("Máximo 100 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (valor.length < 4) {
                $errorSpan.text("Mínimo 4 caracteres").addClass('text-danger').removeAttr('hidden');
                $input.removeClass('is-valid').addClass('is-invalid');
                return;
            }

            if (letras.test(valor)) {
                $errorSpan.text('').addClass('text-danger').attr('hidden', 'hidden');
                $input.removeClass('is-invalid').addClass('is-valid');
                return;
            }
            $errorSpan.text('').attr('hidden', 'hidden');
            $input.removeClass('is-invalid').addClass('is-valid');
        }
    }



    function validarDropDownList(element) {
        const $select = $(element);
        const valor = $select.val();
        var $errorSpan = $select.closest('.input-group').next('p');
        if (valor && valor !== "") {
            $select.removeClass('is-invalid').addClass('is-valid');
            $errorSpan.text("").attr('hidden', 'hidden');
        } else {
            $select.removeClass('is-valid');
        }
    }
    $('select').change(function () {
        validarDropDownList(this);
    });

    function validarCamposObligatorios() {
        let esValido = true;

        $('[data-obligatorio="true"]').each(function () {
            const $input = $(this);
            const tipo = $input.attr('type');
            const name = $input.attr('name');
            const valor = $input.val().trim();
            const $errorSpan = $input.parent().parent().find('p');

            if (tipo === 'radio') {
                if ($('input[name="' + name + '"]:checked').length === 0) {
                    $('#error' + name).text('Este campo es obligatorio').addClass('text-danger').removeAttr('hidden');
                    esValido = false;
                } else {
                    $('#error' + name).text('').addClass('text-danger').attr('hidden', 'hidden');
                }
            } else {
                if (valor === '') {
                    $errorSpan.text('Este campo es obligatorio').addClass('text-danger').removeAttr('hidden');
                    $input.removeClass('is-valid').addClass('is-invalid');
                    esValido = false;
                } else {
                    if (name === 'ConfirmarPassword') {
                        const password = $('#txbPassword').val().trim();
                        if (valor !== password) {
                            $errorSpan.text('Las contraseñas no coinciden').addClass('text-danger').removeAttr('hidden');
                            $input.removeClass('is-valid').addClass('is-invalid');
                            esValido = false;
                            return;
                        }
                    }
                    if (name === 'ConfirmarEmail') {
                        const email = $('#txbEmail').val().trim();
                        if (valor !== email) {
                            $errorSpan.text('Los correos no coinciden').addClass('text-danger').removeAttr('hidden');
                            $input.removeClass('is-valid').addClass('is-invalid');
                            esValido = false;
                            return;
                        }
                    }
                    $errorSpan.text('').addClass('text-danger').attr('hidden', 'hidden');
                    $input.removeClass('is-invalid').addClass('is-valid');
                }
            }
        });

        return esValido;
    }
</script>