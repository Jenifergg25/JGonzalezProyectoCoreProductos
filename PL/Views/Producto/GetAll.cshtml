@model ML.Producto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.12.1/font/bootstrap-icons.min.css">

<div id="tablaUsuarios" @*class="table-responsive"*@>
    <div class="row">
        <div class="row mb-3 align-items-center">
            <div class="col-6 text-start"> 
                <h2 class="m-0">Información de Productos</h2>
            </div>
            <div class="col-6 text-end">
                <a class="btn btn-success" href="@Url.Action("Form", "Producto")">
                    <i class="bi bi-plus-circle"></i> Nuevo Producto
                </a>
            </div>
        </div> 
    </div>
    <div class="card shadow p-4 rounded bg-light">
        @using (Html.BeginForm("GetAll", "Producto", FormMethod.Post))
        {
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.SubCategoria.Categoria.IdCategoria)
                    @Html.DropDownListFor(
                             m => m.SubCategoria.Categoria.IdCategoria,
                             new SelectList(Model.SubCategoria.Categoria.Categorias, "IdCategoria", "Nombre"),
                             "Seleccione una categoría",
                             new { @class = "form-select", id = "ddlCategoria" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.SubCategoria.IdSubCategoria)
                    @Html.DropDownListFor(
                             m => m.SubCategoria.IdSubCategoria,
                             new SelectList(
                             Model.SubCategoria.SubCategorias ?? new List<object>(),
                             "IdSubCategoria",
                             "Nombre",
                             Model.SubCategoria.IdSubCategoria),
                             "Seleccione una subcategoría",
                             new { @class = "form-select", id = "ddlSubcategoria" })

                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Buscar</button>
        }

    </div>


    @if (Model.Productos != null && Model.Productos.Count > 0)
    {
        <div class="mt-4">
            <div class="table-responsive shadow-sm rounded border p-3 bg-white">
                <table class="table table-sm table-striped table-bordered table-hover small text-nowrap">
                    <thead class="table-dark text-center">
                        <tr>
                            <th scope="col">Acciones</th>
                            <th>IdProducto</th>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Descripcion</th>
                            <th>Precio</th>
                            <th>SubCategoria</th>
                            <th>Categoria</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                        @foreach (ML.Producto producto in Model.Productos)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a class="btn btn-warning btn-sm d-flex align-items-center"
                                           href="@Url.Action("Form", "Producto", new { IdProducto = producto.IdProducto })" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a class="btn btn-danger btn-sm d-flex align-items-center"
                                           href="@Url.Action("Delete", "Producto", new { IdProducto = producto.IdProducto })" onclick="return confirmarEliminacion(event, this);"
                                           title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                                <td>@producto.IdProducto</td>
                                <td>
                                    @if (producto.Imagen != null && producto.Imagen.Length > 0)
                                    {
                                        <img src="data:image/*;base64,@Convert.ToBase64String(@producto.Imagen)" style="width:50px" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-box-seam" style="font-size: 2rem; color: gray;"></i>
                                    }
                                </td>
                                <td>@producto.Nombre</td>
                                <td>@producto.Descripcion</td>
                                <td>@producto.Precio</td>
                                <td>@producto.SubCategoria?.Nombre</td>
                                <td>@producto.SubCategoria?.Categoria?.Nombre</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="mt-4 d-flex justify-content-center">
            <div class="alert alert-secondary text-center shadow-sm rounded w-100" role="alert">
                Seleccione una categoría y subcategoría para ver los productos
            </div>
        </div>
    }


</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        $("#ddlCategoria").change(function () {
            var idCategoria = $(this).val();
            $("#ddlSubcategoria").empty(); 
            $("#ddlSubcategoria").append('<option value="">Cargando...</option>');

            if (idCategoria !== "") {
                $.ajax({
                    url: '@Url.Action("GetSubcategorias", "Producto")', 
                    type: 'GET',
                    data: { idCategoria: idCategoria },
                    success: function (data) {
                        $("#ddlSubcategoria").empty();
                        $("#ddlSubcategoria").append('<option value="">Seleccione una subcategoría</option>');

                        $.each(data, function (i, sub) {
                            $("#ddlSubcategoria").append('<option value="' + sub.idSubCategoria + '">' + sub.nombre + '</option>');
                        });
                    }
                });
            }
        });
    });
</script>